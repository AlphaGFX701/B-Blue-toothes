{
  "expo": {
    "name": "BLE Grade Lab",
    "slug": "ble-grade-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ble-grade-lab",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.blegradelab.classroom"
    },
    "android": {
      "package": "com.blegradelab.classroom",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D10",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "react-native-ble-plx",
        {
          "bluetoothAlwaysPermission": "Allow Bluetooth to find classroom devices and read or write lab values.",
          "neverForLocation": true
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "942a8de5-93ff-4c2e-bc1d-b633368bacd7"
      }
    }
  }
}
